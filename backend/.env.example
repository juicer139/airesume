# ============================================
# AI 简历分析平台 - 环境变量模板
# 使用方法: 复制本文件为 .env 并填入真实值
# 真实的 .env 已被 .gitignore 排除，永远不会提交到 GitHub
# ============================================

# ---------- 应用基础 ----------
APP_NAME="AI Resume Analyzer"
DEBUG=true

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=填你的root密码
MYSQL_DB=airesume

# ---------- JWT 认证（阶段 2 使用）----------
# 生成随机密钥命令: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- AI 服务（阶段 5 使用，三大厂商都兼容 OpenAI 协议）----------
# DeepSeek: https://platform.deepseek.com  BaseURL: https://api.deepseek.com/v1  模型: deepseek-chat
# 通义千问: https://dashscope.console.aliyun.com  BaseURL: https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus
# OpenAI:   https://platform.openai.com    BaseURL: https://api.openai.com/v1  模型: gpt-4o-mini
AI_API_KEY=sk-xxx
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ---------- Redis / Celery（阶段 6 使用）----------
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# ---------- 文件上传（阶段 4 使用）----------
UPLOAD_DIR=uploads
